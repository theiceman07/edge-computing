[Unit]
Description=Motor health dashboard
After=network-online.target

[Service]
User=juice
WorkingDirectory=/home/juice/motor-fault-monitor
ExecStart=/home/juice/motor-fault-monitor/.venv/bin/streamlit run app.py --server.address 127.0.0.1 --server.port 8501 --server.headless true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
